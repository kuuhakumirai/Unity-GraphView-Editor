GraphEditorView 
{
    flex-direction: column;
    flex: 1;
}

GraphEditorView > #toolbar > #button
{
    flex: 1 1 auto;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: rgb(62, 62, 62);
}

GraphEditorView > #toolbar > #button:hover 
{
    background-color: rgba(88, 88, 88, 1);
}


GraphEditorView > #content 
{
    flex: 1;
    flex-direction: row;
}

GraphEditorView > #content > #GraphView 
{
    flex: 1;
}